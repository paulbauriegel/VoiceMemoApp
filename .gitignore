.gradle/
.kotlin/
.idea/
build/
**/build/
local.properties
*.iml
.DS_Store

# Local model conversion/cache output. Source model manifests and fetch scripts
# remain tracked; these generated binary artifacts can be recreated.
app/model-cache/

# Generated by scripts/fetch-whisper-assets.sh. The 1.09 GB rewritten model is
# derived from a pinned, verified source model instead of being committed.
app/src/main/generatedAssets/

# Room writes schema snapshots here during compilation. Keep JSON snapshots,
# but ignore temporary compiler output.
app/schemas/*.tmp

# Timestamped on-device performance reports collected by the developer tools.
benchmark-results/

scripts/__pycache__/
scripts/tests/__pycache__/
