+void whisper_enable_encoder_block_diagnostics(
+        struct whisper_context * ctx,
+                          bool   enabled) {
+    if (ctx == nullptr || ctx->state == nullptr) {
+        return;
+    }
+    ctx->state->encoder_block_diagnostics_enabled = enabled;
+    ctx->state->encoder_block_diagnostics.clear();
+    ctx->state->encoder_block_diagnostic_values.clear();
+}
+
+int whisper_encoder_block_diagnostic_count(struct whisper_context * ctx) {
+    if (ctx == nullptr || ctx->state == nullptr) {
+        return -1;
+    }
+    return static_cast<int>(ctx->state->encoder_block_diagnostic_values.size());
+}
+
+int whisper_copy_encoder_block_diagnostic(
+        struct whisper_context * ctx,
+                          int   index,
+                       float * output,
+                          int   n_elements) {
+    if (
+        ctx == nullptr || ctx->state == nullptr || output == nullptr || index < 0 ||
+        index >= static_cast<int>(ctx->state->encoder_block_diagnostic_values.size())
+    ) {
+        return -1;
+    }
+    const auto & values = ctx->state->encoder_block_diagnostic_values[index];
+    if (n_elements != static_cast<int>(values.size())) {
+        return -2;
+    }
+    memcpy(output, values.data(), values.size() * sizeof(float));
+    return 0;
+}
