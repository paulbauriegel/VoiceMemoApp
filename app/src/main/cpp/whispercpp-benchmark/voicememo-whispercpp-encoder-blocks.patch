+static bool whisper_encoder_block_diagnostic_callback(
+        struct ggml_tensor * tensor,
+                         bool ask,
+                       void * user_data) {
+    auto * state = static_cast<whisper_state *>(user_data);
+    const auto found = std::find(
+        state->encoder_block_diagnostics.begin(),
+        state->encoder_block_diagnostics.end(),
+        tensor
+    );
+    if (found == state->encoder_block_diagnostics.end()) {
+        return !ask;
+    }
+    if (ask) {
+        return true;
+    }
+    const size_t index = static_cast<size_t>(
+        std::distance(state->encoder_block_diagnostics.begin(), found)
+    );
+    if (tensor->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (state->encoder_block_diagnostic_values.size() != state->encoder_block_diagnostics.size()) {
+        state->encoder_block_diagnostic_values.resize(state->encoder_block_diagnostics.size());
+    }
+    auto & values = state->encoder_block_diagnostic_values[index];
+    values.resize(static_cast<size_t>(ggml_nelements(tensor)));
+    ggml_backend_tensor_get(tensor, values.data(), 0, ggml_nbytes(tensor));
+    return true;
+}
