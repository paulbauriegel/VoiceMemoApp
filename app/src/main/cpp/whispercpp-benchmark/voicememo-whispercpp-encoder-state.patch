+int whisper_encoder_state_n_elements(struct whisper_context * ctx) {
+    if (ctx == nullptr || ctx->state == nullptr || ctx->state->embd_enc == nullptr) {
+        return -1;
+    }
+    return static_cast<int>(ggml_nelements(ctx->state->embd_enc));
+}
+
+int whisper_encoder_state_n_ctx(struct whisper_context * ctx) {
+    if (ctx == nullptr || ctx->state == nullptr || ctx->state->embd_enc == nullptr) {
+        return -1;
+    }
+    return static_cast<int>(ctx->state->embd_enc->ne[1]);
+}
+
+int whisper_encoder_state_n_state(struct whisper_context * ctx) {
+    if (ctx == nullptr || ctx->state == nullptr || ctx->state->embd_enc == nullptr) {
+        return -1;
+    }
+    return static_cast<int>(ctx->state->embd_enc->ne[0]);
+}
+
+int whisper_copy_encoder_state(
+        struct whisper_context * ctx,
+                       float * output,
+                         int   n_elements) {
+    if (ctx == nullptr || ctx->state == nullptr || ctx->state->embd_enc == nullptr || output == nullptr) {
+        return -1;
+    }
+    const ggml_tensor * tensor = ctx->state->embd_enc;
+    if (tensor->type != GGML_TYPE_F32 || n_elements != ggml_nelements(tensor)) {
+        return -2;
+    }
+    ggml_backend_tensor_get(tensor, output, 0, ggml_nbytes(tensor));
+    return 0;
+}
